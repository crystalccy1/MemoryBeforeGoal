{
  "schema_version": 1,
  "runtime_base": "${PACKAGE}/runtime",
  "python": {
    "server": "python3",
    "client": "python3"
  },
  "bundle": "${PACKAGE}/../bundles/SET_BY_PREPARE_BUNDLE",
  "server": {
    "host": "127.0.0.1",
    "port": 8000,
    "device": "cuda:0",
    "inference_steps": 6,
    "attention_backend": "sdpa"
  },
  "client": {
    "server_url": "ws://127.0.0.1:8000/ws",
    "state_endpoint": "tcp://127.0.0.1:5557",
    "camera_endpoint": "tcp://127.0.0.1:5555",
    "pose_bind": "tcp://*:5556",
    "instruction": "SET_BY_PREPARE_BUNDLE",
    "log_dir": "${PACKAGE}/logs/client"
  },
  "controller": {
    "original_sonic_root": "/path/to/GR00T-WholeBodyControl",
    "isolated_source": "${PACKAGE}/runtime/controller-source",
    "tensorrt_root": "/path/to/TensorRT",
    "config": "${PACKAGE}/config/controller.json"
  }
}
