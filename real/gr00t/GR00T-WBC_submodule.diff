+    def stop(self, timeout: float = 5.0) -> str:
+        """Wait a bounded time for the worker to finish all frames and close."""
+        self._stopping = True
+        if self._thread is None:
+            return self.output_path
+        deadline = time.monotonic() + timeout
+        while not self._sentinel_sent and self._thread.is_alive():
+            self._check_error()
+            remaining = deadline - time.monotonic()
+            if remaining <= 0:
