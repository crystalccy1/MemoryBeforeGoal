+def _validate_controller_dataset(save_root: Path, robot_config: dict) -> None:
+    """Identify the controller and prevent mixing checkpoints in one dataset."""
+    deploy_root = Path(__file__).resolve().parents[2] / "gear_sonic_deploy"
+    hashes = {}
+    for key in ("model_path", "encoder_file", "obs_config_path"):
+        value = robot_config.get(key)
+        if not value or value == "none":
+            continue
+        path = Path(value)
+        if not path.is_absolute():
+            path = deploy_root / path
+        digest = hashlib.sha256()
+        with path.open("rb") as stream:
+            for chunk in iter(lambda: stream.read(1024 * 1024), b""):
+                digest.update(chunk)
+        hashes[key] = digest.hexdigest()
+    robot_config["controller_sha256"] = hashes
+    info_path = save_root / "meta" / "info.json"
